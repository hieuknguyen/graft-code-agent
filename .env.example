# The application reads these from its environment; it never writes them to config.yaml.
# In PowerShell: $env:GEMINI_API_KEY = "your-key"
GRAFT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional legacy gateway configuration. Only use when GRAFT_PROVIDER=gateway.
# GRAFT_GATEWAY_URL=http://localhost:5678/webhook/antigravity-chat
# GRAFT_API_KEY=
# GRAFT_MODEL=
